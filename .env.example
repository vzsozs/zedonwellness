# Database
DATABASE_URL=postgresql://zw_user:zw_password@localhost:5432/zw_shop

# Admin auth (next-auth) — generate with: openssl rand -base64 32
AUTH_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to "true" on the zw.formagyar.hu staging domain to block search engine indexing.
# Must be unset/false on the live production domain.
NEXT_PUBLIC_STAGING_NOINDEX=true

# Stripe (test keys during development)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Above this gross order total (HUF), online payment is disabled and only
# an order request (no payment) can be submitted.
ORDER_ONLY_THRESHOLD_HUF=1000000
