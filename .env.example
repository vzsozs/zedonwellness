# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://zw_user:zw_password@localhost:5432/zw_shop

# Used by docker-compose to create the Postgres container. DB_PASSWORD has
# no default — the stack refuses to start without it.
DB_USER=zw_user
DB_PASSWORD=
DB_NAME=zw_shop

# ── Admin auth (next-auth) ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Required behind a reverse proxy (Nginx Proxy Manager) or on a non-standard
# host/port — without it, next-auth rejects requests as "UntrustedHost".
AUTH_TRUST_HOST=true

# ── App ─────────────────────────────────────────────────────────────────
# Canonical origin. Used for canonical URLs, hreflang, sitemap and JSON-LD,
# so it must be the real public domain in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to "true" on the zw.formagyar.hu staging domain to block search engine
# indexing. Must be unset/false on the live production domain.
NEXT_PUBLIC_STAGING_NOINDEX=true

# ── Transactional e-mail (order confirmation + internal notification) ───
# Without these the order still goes through, but nobody gets an e-mail —
# the app logs a warning instead of failing the checkout.
RESEND_API_KEY=
MAIL_FROM="Zedonwellness <rendeles@zedonwellness.com>"
ORDER_NOTIFICATION_EMAIL=

# ── Blog (Soro CMS) ─────────────────────────────────────────────────────
# Public embed token from the Soro dashboard.
SORO_EMBED_TOKEN=

# ── Stripe (test keys during development) ───────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Business rules ──────────────────────────────────────────────────────
# Above this gross order total (HUF), online payment is disabled and only
# an order request (no payment) can be submitted.
ORDER_ONLY_THRESHOLD_HUF=1000000
