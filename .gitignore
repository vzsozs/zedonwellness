# deps
/node_modules

# next
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (never commit secrets)
.env
.env*.local
.env.production

# typescript
*.tsbuildinfo
next-env.d.ts

# uploads (local dev, mounted as volume in prod) — served dynamically via
# src/app/uploads/[...path]/route.ts, kept outside public/ on purpose
/uploads

# raw Webflow export dump used as a one-off migration source
# (see scripts/migrate-webflow/) — not meant to be committed
/Ideiglenes

# generated design canvas payload (regenerate from the .dc.html sources with seed-canvas.mjs)
design-mockups/**/*-mockups.html
